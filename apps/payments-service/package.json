{
  "name": "@lab/payments-service",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "predev": "npm run build -w @lab/messaging",
    "prebuild": "npm run build -w @lab/messaging",
    "pretypecheck": "npm run build -w @lab/messaging",
    "dev": "tsc-watch --noClear --onSuccess \"node dist/main.js\"",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "migration:run": "npm run build && typeorm migration:run -d dist/database/data-source.js",
    "migration:show": "npm run build && typeorm migration:show -d dist/database/data-source.js"
  },
  "dependencies": {
    "@lab/messaging": "*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.13.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "tsc-watch": "^7.2.0",
    "@types/node": "^22.19.0"
  }
}
